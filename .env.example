# backend
CAR_DATA_API=
MAPBOX_API=
OPENCAGE_KEY=
TRIPADVISOR_API=
DATABASE_URL=
# Browser origins allowed by the API, including the Vercel production frontend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:8082,https://roadtrips.elischiffler.dev,https://roadtripsarefun.vercel.app
# Keep require for Neon/remote hosts. Set disable ONLY on the dedicated same-host
# Docker database network; use verify-full plus trusted certificates across hosts.
DATABASE_SSLMODE=require
# Required for backend verification of frontend Cognito access tokens.
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# chat agent LLM provider — the self-hosted Mentro gateway (SSE chat endpoint).
# The backend calls {MENTRO_GATEWAY_URL}/api/chat/stream-full server-to-server,
# authenticating with a Supabase JWT minted from a dedicated service account in
# the gateway's Supabase project. Leave the service creds blank to run without
# the agent (the provider reports itself "not configured" and the endpoint 503s).
MENTRO_GATEWAY_URL=https://api.mentro.elischiffler.dev
SUPABASE_URL=
SUPABASE_ANON_KEY=
MENTRO_SERVICE_EMAIL=
MENTRO_SERVICE_PASSWORD=

# Local dev only: proxy the agent's IP-whitelisted routing calls
# (Mapbox/TripAdvisor/hotels) through your DEPLOYED roadtrip backend, which has
# the whitelisted IP. Set this to the AWS API base URL when developing
# locally; leave BLANK on the deployed backend (it runs routing locally there).
ROUTING_REMOTE_URL=

# frontend
VITE_BACKEND_SERVER=
# Production uses VITE_BACKEND_SERVER=https://api.roadtrips.elischiffler.dev/.
# Verify the API's health and CORS preflight before changing a browser target.
VITE_CLIENT_ID=
VITE_USERPOOL_ID=
VITE_MAPBOX_TOKEN=

# Optional backend-only signing secret (32+ random characters) for Studio sessions.
# Set the same secret on every deployed API worker; omit locally to reset on restart.
STUDIO_SESSION_SECRET=
